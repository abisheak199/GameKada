# GameKada Environment Variables
# Copy this file to .env and fill in your values

# RAWG Video Games Database API key (free tier: 20,000 requests/month)
# Get your key at: https://rawg.io/apidocs
VITE_RAWG_API_KEY=78247866f42047a78ddc851dbb2c88ab

# Data source: 'local' (uses src/data/games.js) or 'api' (fetches from RAWG)
VITE_DATA_SOURCE=api
